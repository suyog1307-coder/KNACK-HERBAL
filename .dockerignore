**/*.spec.ts
**/*.e2e-spec.ts
**/test

# ── Dev tooling ───────────────────────────────────────────────────────────────
.husky
.vscode
.github
*.log
*.tsbuildinfo

# ── Secrets (never bake into image) ──────────────────────────────────────────
apps/backend/.env
apps/backend/.env.*
.env
.env.*

# ── Misc ──────────────────────────────────────────────────────────────────────
README.md
*.sql
