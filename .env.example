# ══════════════════════════════════════════════════════════════════
#  Knack Herbal — Environment Variables
#  Copy this file to apps/backend/.env and fill in your values.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:student@localhost:5433/knack_herbal?schema=public

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET="knack_herbal_super_secret_dev_key_123"
JWT_REFRESH_SECRET="knack_herbal_super_secret_refresh_key_456"

# ── Razorpay ──────────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use test keys during development (prefix rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Email (SMTP / Nodemailer) ─────────────────────────────────────
# Supports: Gmail, SendGrid, Mailgun, any SMTP provider
# Gmail example: smtp.gmail.com port 587
# Install: pnpm add nodemailer @types/nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Knack Herbal <noreply@knackherbal.com>"

# ── SMS / WhatsApp (Twilio) ───────────────────────────────────────
# Get credentials from: https://console.twilio.com
# Install: pnpm add twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=+14155238886

# ── File Uploads ──────────────────────────────────────────────────
# Local disk uploads (default — files saved to apps/backend/uploads/)
# For S3: install @aws-sdk/client-s3 multer-s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=knack-herbal-assets

# For Cloudinary: install cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud
# CLOUDINARY_API_KEY=your_key
# CLOUDINARY_API_SECRET=your_secret

# ── Redis (optional — enables caching & queues) ───────────────────
# Install: pnpm add ioredis @nestjs/cache-manager cache-manager-redis-yet
# REDIS_URL=redis://localhost:6379

# ── Google Maps (optional — for delivery tracking) ────────────────
# GOOGLE_MAPS_API_KEY=your_key
